# Copy to admin/.env. Only VITE_-prefixed variables reach the browser, and
# everything here is meant to — there are no secrets in the admin bundle. The
# panel authenticates by calling the API; it never holds a key of its own.

VITE_ADMIN_API_BASE_URL=http://localhost:8080/api/v1

# Where the "Preview" and "View live" links point. Used to open a piece of
# content on the public site from its editor.
VITE_PUBLIC_SITE_URL=http://localhost:5173
