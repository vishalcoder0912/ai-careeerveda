# Copy to backend/.env and fill in. `.env` is gitignored — never commit it.
#
# Every variable here is read only by this Node process. None is exposed to a
# browser: the public frontend and the admin panel talk to this API over HTTP and
# never receive these values.
#
# The server validates this file at boot (src/config/env.js) and exits with a
# list of problems rather than starting in a half-configured state.

NODE_ENV=development
# Cloud Run injects PORT and expects the container to honour it.
PORT=8080

# --- Database ----------------------------------------------------------------
# Choose ONE: MongoDB (Atlas) OR Firestore (Native mode with MongoDB compatibility)
#
# Option A: MongoDB Atlas / Local
# MONGODB_URI=mongodb+srv://user:pass@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=careerveda
#
# Option B: Firestore (Native mode) with MongoDB compatibility
# Enable MongoDB compatibility in Firebase Console → Firestore → MongoDB compatibility
# MONGODB_URI=mongodb://firestore.googleapis.com:27017/careerveda?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false
# MONGODB_DB_NAME=careerveda
# FIRESTORE_PROJECT_ID=your-gcp-project-id
# FIRESTORE_DATABASE=(default)
#
# For local development with Firestore Emulator:
# FIRESTORE_EMULATOR_HOST=localhost:8080
# MONGODB_URI=mongodb://localhost:8080/careerveda

MONGODB_URI=
MONGODB_DB_NAME=careerveda
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE=(default)
FIRESTORE_EMULATOR_HOST=

# --- CORS --------------------------------------------------------------------
# FRONTEND_URL and ADMIN_URL are always allowed. CORS_ALLOWED_ORIGINS adds extra
# origins (preview deploys, staging) as a comma-separated list.
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Tokens ------------------------------------------------------------------
# Minimum 32 characters each, and they must differ from one another: reusing one
# secret for both means a leaked access token can be replayed as a refresh token.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- Cookies -----------------------------------------------------------------
# Leave COOKIE_DOMAIN blank for localhost. In production set the parent domain
# (e.g. .careerveda.in) so api. and admin. share the refresh cookie.
COOKIE_DOMAIN=
# MUST be true in production — a refresh cookie without Secure travels in clear
# text over any plain-HTTP request to the domain.
COOKIE_SECURE=false

# --- ImageKit ----------------------------------------------------------------
# The private key stays here and only here. It is never sent to a browser.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Email (Hire From Us) ---------------------------------------------------
# Each hiring enquiry emails LEAD_NOTIFY_EMAIL and a confirmation to the sender.
# Leave SMTP_HOST blank to skip email (the lead is still saved).
# Gmail: smtp.gmail.com, port 465, SMTP_PASS = a Google "App password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CareerVeda <Info@careerveda.in>"
LEAD_NOTIFY_EMAIL=Info@careerveda.in

# --- Cloudflare Turnstile (CAPTCHA on the public forms) ----------------------
# Secret key from Cloudflare dash -> Turnstile. Pair with VITE_TURNSTILE_SITE_KEY
# in the frontend build. Blank skips the check locally; REQUIRED when
# COOKIE_SECURE=true (the server refuses to boot without it).
# Test keys: 1x0000000000000000000000000000000AA (always passes),
#            2x0000000000000000000000000000000AA (always fails).
TURNSTILE_SECRET_KEY=
# Run an https deploy with no CAPTCHA at all: leave both keys blank and set this.
TURNSTILE_DISABLED=false

# Proxy hops in front of the API. Cloud Run alone: 1. Cloudflare -> Cloud Run: 2.
# VM behind nginx: always 1, even with Cloudflare (nginx unwraps CF-Connecting-IP).
# Wrong values either merge every visitor into one rate-limit bucket or let
# clients spoof their IP. See app.js.
TRUST_PROXY=1

LOG_LEVEL=info
