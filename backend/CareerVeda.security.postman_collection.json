        {
          "name": "Login flood — expect 429 within 11 tries",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"tries\", Number(pm.variables.get(\"tries\") || 0) + 1);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tries = Number(pm.variables.get(\"tries\"));",
                  "if (pm.response.code === 429) {",
                  "  pm.test(`rate limited after ${tries} tries`, () => pm.expect(tries).to.be.at.most(11));",
                  "} else if (tries < 12) {",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.test(\"rate limited within 11 tries\", () => pm.expect.fail(\"12 logins went through without a 429\"));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
