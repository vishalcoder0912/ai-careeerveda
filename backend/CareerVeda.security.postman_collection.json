    {
      "name": "A02 · Cryptographic failures / transport",
      "description": "Are secrets protected in transit? (Most checks only apply over https.)",
      "item": [
        {
          "name": "HSTS and transport headers",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const https = pm.collectionVariables.get(\"baseUrl\").startsWith(\"https://\");",
                  "pm.test(\"HSTS present on https\", () => {",
                  "  if (!https) return pm.expect(true, \"skipped: baseUrl is not https\").to.be.true;",
                  "  pm.expect(pm.response.headers.get(\"Strict-Transport-Security\")).to.match(/max-age=\\d{7,}/);",
                  "});",
                  "pm.test(\"production is served over https\", () => {",
                  "  if (pm.collectionVariables.get(\"isProduction\") !== \"true\") return;",
                  "  pm.expect(https, \"isProduction=true but baseUrl is http — credentials travel in clear text\").to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
