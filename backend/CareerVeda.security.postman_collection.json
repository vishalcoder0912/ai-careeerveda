                  "pm.test(\"no stack trace or internals leak\", () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.not.match(/\\bat \\w+ \\(|node_modules|MongoServerError|JWT_|\\.js:\\d+/);",
