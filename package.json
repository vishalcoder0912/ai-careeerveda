{
  "name": "scene-one-career-veda",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend,admin -c blue,green,magenta \"npm:dev:backend\" \"npm:dev:frontend\" \"npm:dev:admin\"",
    "dev:frontend": "vite",
    "dev:backend": "npm --prefix backend run dev",
    "dev:admin": "npm --prefix admin run dev",
    "docker": "docker compose watch",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "build": "vite build",
    "build:frontend": "vite build",
    "build:backend": "npm --prefix backend run build",
    "build:admin": "npm --prefix admin run build",
    "build:all": "npm run build:frontend && npm run build:backend && npm run build:admin",
    "lint": "eslint . && echo Lint OK - no errors found",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:frontend": "vitest run",
    "test:backend": "npm --prefix backend test",
    "test:admin": "npm --prefix admin test",
    "test:all": "npm run test:frontend && npm run test:backend && npm run test:admin",
    "test:jest:frontend": "node node_modules/jest/bin/jest.js --config jest.frontend.config.cjs",
    "test:jest:admin": "node node_modules/jest/bin/jest.js --config jest.admin.config.cjs",
    "test:jest:backend": "npm --prefix backend run test:unit",
    "test:jest": "npm run test:jest:frontend && npm run test:jest:admin && npm run test:jest:backend",
    "test:e2e": "playwright test --grep-invert \"@visual|@performance|@smoke\"",
    "test:e2e:all": "playwright test",
    "test:a11y": "playwright test accessibility --grep-invert \"@visual\"",
    "test:performance": "playwright test --grep @performance --project=chromium",
    "test:smoke": "playwright test --grep @smoke --project=chromium",
    "test:load": "node scripts/load-test.mjs",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "check": "npm run lint && npm run test:all && npm run build:all",
    "preview": "vite preview",
    "serve:dist": "node scripts/serve-dist.cjs",
    "check:db": "node scripts/check-db.mjs",
    "blogs:export": "node scripts/export-blogs.mjs",
    "sitemap": "node scripts/generate-sitemap.mjs",
    "llms": "node scripts/generate-llms-txt.mjs",
    "logo": "node scripts/make-logo.mjs",
    "prerender": "node scripts/prerender.mjs",
    "snapshot": "node scripts/snapshot.mjs",
    "seo:audit": "node scripts/seo-audit.mjs",
    "prebuild": "node scripts/generate-sitemap.mjs && node scripts/generate-llms-txt.mjs",
    "postbuild": "node scripts/prerender.mjs && node scripts/snapshot.mjs",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@use-gesture/react": "^10.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "mongodb": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.2",
    "three": "^0.185.1",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "babel-jest": "^30.4.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.10"
  }
}
