# Build-time settings for deploy/deploy.sh. Copy to /etc/careerveda/build.env
# on the VM (setup-server.sh does this for you) and fill in.
#
# Every VITE_* value is baked into JavaScript that browsers download, so ONLY
# public values belong here. Secrets go in /opt/careerveda/backend/.env.

# Where the site and the admin panel call the API. nginx proxies /api on the
# site's own host to the Node backend, so this is the site's URL + /api/v1.
# Absolute URL required (the API client builds it with new URL()).
#   Testing on the bare IP:  http://34.xx.xx.xx/api/v1
#   Production:              https://careerveda.in/api/v1
VITE_PUBLIC_API_BASE_URL=
VITE_ADMIN_API_BASE_URL=

# The public site's address, used by the admin panel's "View on site" links.
VITE_PUBLIC_SITE_URL=

# Cloudflare Turnstile SITE key (public). Pair with TURNSTILE_SECRET_KEY in
# backend/.env. Set both or neither: a secret without this key rejects every
# form submission; a key without the secret skips the check.
VITE_TURNSTILE_SITE_KEY=
