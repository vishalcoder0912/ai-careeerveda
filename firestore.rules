rules_version = '2';

// No browser or mobile client talks to Firestore directly. Every read and write
// goes through the backend API (MongoDB driver, Firestore Enterprise), which
// does its own auth, validation and rate limiting, and is not subject to these
// rules. So clients get nothing: an open rule here would only be a way around
// the API (e.g. writing leads without the form's rate limit).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
